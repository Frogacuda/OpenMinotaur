      ]
    },
    "radialFace": {
      "kind": "group",
      "inputs": {
        "remaining": 0,
        "duration": 1,
        "timeText": "",
        "accent": [0.39, 0.86, 0.96, 1],
        "timeFont": "neon-hud"
      },
      "size": [132, 132],
      "children": [
        {
          "id": "fraction",
          "kind": "logic",
          "value": ["normalize", ["get", "remaining"], 0, ["get", "duration"]]
        },
        {
          "id": "meterColor",
          "kind": "logic",
          "value": ["get", "accent"]
        },
        {
          "id": "ring",
          "kind": "radial",
          "size": [132, 132],
          "segments": 16,
          "fill": ["get", "fraction"],
          "color": ["get", "meterColor"],
          "trackColor": [0.14, 0.21, 0.28, 1]
        },
        {
          "id": "ring-time",
