          "color": [0, 0, 0, 0.35]
        },
        {
          "id": "top",
          "use": "frameBeam",
          "x": 2,
          "y": 2,
          "scale": [1, ["/", ["-", ["get", "width"], 4], 16]],
          "rotation": -90
        },
        {
          "id": "right",
          "use": "frameBeam",
          "x": ["-", ["get", "width"], 2],
          "y": 2,
          "scale": [1, ["/", ["-", ["get", "height"], 4], 16]],
          "rotation": 0
        },
        {
          "id": "bottom",
          "use": "frameBeam",
          "x": 2,
          "y": ["-", ["get", "height"], 2],
