    "children": [
      {"id": "left-top", "use": "checkpointStack"},
      {"id": "left-bottom", "use": "runStats"},
      {"id": "right-top", "use": "pickupLog"},
      {
        "id": "right-bottom",
        "kind": "group",
        "size": [
          304,
          ["get", "panelHeight"]
        ],
        "x": 22,
        "y": 468,
        "pivot": [0, 1],
        "scale": ["get", "railScale"],
        "placement": {
          "landscape": "gameplay-right"
        },
        "children": [
          {
            "id": "panelHeight",
            "kind": "logic",
            "value": [
              "max",
              0,
              [
                "-",
                [
                  "*",
                  88,
                  [
                    "min",
                    6,
                    [
                      "count",
