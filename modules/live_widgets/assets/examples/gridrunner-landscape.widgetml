{
  "widgetML": 1,
  "region": "bezel",
  "assets": {
    "pickup-ring": "widget-pickup-ring.png"
  },
  "templates": {
    "checkpointStack": {
      "kind": "group",
      "size": [304, 188],
      "x": -22,
      "y": -468,
      "visible": ["coalesce", ["read", "checkpointVisible"], true],
      "pivot": [1, 0],
      "scale": ["get", "railScale"],
      "placement": {
        "landscape": "gameplay-left"
      },
      "children": [
        {
          "id": "checkpoint-score",
          "use": "statBox",
          "inputs": {
            "label": "Checkpoint Score",
            "value": ["coalesce", ["read", "checkpointScore"], "238,600"],
            "stacked": true
          }
        },
        {
          "id": "next-checkpoint",
          "use": "statBox",
          "y": 100,
          "inputs": {
            "label": "Next Checkpoint",
            "value": ["coalesce", ["read", "nextCheckpoint"], "Grid 9"],
            "stacked": true
          }
        }
      ],
      "inputs": {
        "railScale": ["get", "railScale"]
      }
    },
    "runStats": {
      "kind": "group",
      "size": [304, 138],
      "x": -22,
      "y": 468,
      "pivot": [1, 1],
      "scale": ["get", "railScale"],
      "placement": {
        "landscape": "gameplay-left"
      },
      "children": [
        {
          "id": "stats-frame",
          "use": "bezelFrame",
          "inputs": {
            "height": 138
          }
        },
        {
          "id": "stats",
          "kind": "repeat",
          "items": ["get", "stats"],
          "y": 13,
          "maximum": 4,
          "layout": {
            "type": "column",
            "cell": [304, 30]
          },
          "template": {
            "id": "row",
            "kind": "group",
            "opacity": ["if", ["get", "item.completed"], 0.75, 1],
            "children": [
              {
                "id": "rowLabel",
                "kind": "logic",
                "value": ["get", "item.label"]
              },
              {
                "id": "rowValue",
                "kind": "logic",
                "value": ["get", "item.value"]
              },
              {
                "id": "name",
                "kind": "text",
                "text": "{rowLabel}",
                "fontSize": 13,
                "lineWidth": 1.35,
                "color": ["if", ["get", "item.completed"], [0.53, 1, 0.63, 1], [0.79, 0.87, 0.94, 1]],
                "x": 15,
                "y": 1,
                "font": "neon-hud"
              },
              {
                "id": "value",
                "kind": "text",
                "text": "{rowValue}",
                "fontSize": 16,
                "lineWidth": 1.35,
                "color": ["if", ["get", "item.completed"], [0.53, 1, 0.63, 1], [0.97, 0.99, 1, 1]],
                "x": 15,
                "y": 0,
                "size": [274, 19],
                "align": "right",
                "font": "neon-hud"
              }
            ]
          }
        }
      ],
      "inputs": {
        "railScale": ["get", "railScale"],
        "stats": ["get", "stats"]
      }
    },
    "pickupLog": {
      "kind": "group",
      "size": [304, ["get", "logHeight"]],
      "x": 22,
      "y": -468,
      "pivot": [0, 0],
      "scale": ["get", "railScale"],
      "placement": {
        "landscape": "gameplay-right"
      },
      "children": [
        {
          "id": "logHeight",
          "kind": "logic",
          "value": ["+", 59, ["*", 30, ["max", ["get", "reservedRows"], ["min", 5, ["count", ["get", "pickups"]]]]]]
        },
        {
          "id": "pickup-panel",
          "use": "panel",
          "inputs": {
            "title": "Last 5 Pickups",
            "height": ["get", "logHeight"]
          }
        },
        {
          "id": "pickups",
          "kind": "repeat",
          "items": ["get", "pickups"],
          "y": 47,
          "maximum": 5,
          "layout": {
            "type": "column",
            "cell": [304, 30]
          },
          "template": {
            "id": "row",
            "kind": "group",
            "children": [
              {
                "id": "rowLabel",
                "kind": "logic",
                "value": ["get", "item.label"]
              },
              {
                "id": "tint",
                "kind": "logic",
                "value": ["get", "item.tint"]
              },
              {
                "id": "icon",
                "kind": "sprite",
                "asset": "pickup-ring",
                "x": 12,
                "y": -3,
                "size": [28, 28],
                "color": ["get", "tint"]
              },
              {
                "id": "name",
                "kind": "text",
                "text": "{rowLabel}",
                "fontSize": 16,
                "lineWidth": 1.35,
                "color": [0.97, 0.99, 1, 1],
                "x": 47,
                "y": 3,
                "font": "neon-hud"
              }
            ]
          }
        }
      ],
      "inputs": {
        "railScale": ["get", "railScale"],
        "pickups": ["get", "pickups"],
        "reservedRows": 0
      }
    },
    "cooldownRow": {
      "kind": "group",
      "children": [
        {
          "id": "rowLabel",
          "kind": "logic",
          "value": ["get", "item.label"]
        },
        {
          "id": "remaining",
          "kind": "logic",
          "value": ["get", "item.remaining"]
        },
        {
          "id": "duration",
          "kind": "logic",
          "value": ["get", "item.duration"]
        },
        {
          "id": "timeText",
          "kind": "logic",
          "value": ["get", "item.timeText"]
        },
        {
          "id": "tint",
          "kind": "logic",
          "value": ["get", "item.tint"]
        },
        {
          "id": "card",
          "use": "cooldownCard",
          "inputs": {
            "rowLabel": ["get", "rowLabel"],
            "remaining": ["get", "remaining"],
            "duration": ["get", "duration"],
            "timeText": ["get", "timeText"],
            "tint": ["get", "tint"],
            "width": ["get", "cardWidth"],
            "height": ["get", "cardHeight"]
          }
        }
      ],
      "inputs": {
        "cardWidth": 304,
        "cardHeight": 80
      }
    },
    "portraitLayout": {
      "kind": "group",
      "children": [
        {
          "id": "checkpoint-stack",
          "use": "checkpointStack",
          "placement": {
            "origin": "screen-top-left"
          },
          "scale": ["*", 1.02, ["get", "railScale"]],
          "x": ["*", 24, ["get", "railScale"]],
          "y": ["coalesce", ["read", "portraitInset"], 15],
          "pivot": [0, 0]
        },
        {
          "id": "run-stats",
          "use": "runStats",
          "placement": {
            "origin": "screen-top-right"
          },
          "scale": ["*", 1.35, ["get", "railScale"]],
          "x": ["*", -24, ["get", "railScale"]],
          "y": ["coalesce", ["read", "portraitInset"], 15],
          "pivot": [1, 0]
        },
        {
          "id": "pickup-log",
          "use": "pickupLog",
          "placement": {
            "origin": "screen-bottom-left"
          },
          "scale": ["*", 0.95, ["get", "railScale"]],
          "x": ["*", 24, ["get", "railScale"]],
          "y": ["-", 0, ["coalesce", ["read", "portraitInset"], 15]],
          "pivot": [0, 1],
          "inputs": {
            "reservedRows": 5
          }
        },
        {
          "id": "cooldown-grid",
          "kind": "group",
          "placement": {
            "origin": "screen-bottom-right"
          },
          "pivot": [1, 1],
          "x": ["*", -24, ["get", "railScale"]],
          "y": ["-", 0, ["coalesce", ["read", "portraitInset"], 15]],
          "scale": ["*", 0.85, ["get", "railScale"]],
          "size": [758, ["get", "gridHeight"]],
          "inputs": {
            "railScale": ["get", "railScale"],
            "effects": ["get", "effects"]
          },
          "children": [
            {
              "id": "gridHeight",
              "kind": "logic",
              "value": ["/", ["*", 209, 0.95], 0.85]
            },
            {
              "id": "cardHeight",
              "kind": "logic",
              "value": ["/", ["-", ["get", "gridHeight"], 14], 2]
            },
            {
              "id": "cooldowns",
              "kind": "repeat",
              "items": ["get", "effects"],
              "maximum": 6,
              "inputs": {"cardHeight": ["get", "cardHeight"]},
              "layout": {
                "type": "column",
                "cell": [0, 0]
              },
              "template": {
                "id": "row",
                "use": "cooldownRow",
                "x": ["*", 258, ["-", 2, ["get", "item.column"]]],
                "y": ["*", ["get", "item.row"], ["+", ["get", "cardHeight"], 14]],
                "inputs": {
                  "cardWidth": 242,
                  "cardHeight": ["get", "cardHeight"]
                }
              }
            }
          ]
        }
      ]
    },
    "frameBeam": {
      "kind": "vector",
      "size": [2, 17],
      "points": [
        [0, 0],
        [0, 16]
      ],
      "lineWidth": 1.9,
      "color": [0.32, 0.65, 0.82, 1],
      "opacity": 0.60
    },
    "bezelFrame": {
      "kind": "group",
      "inputs": {
        "width": 304,
        "height": 88
      },
      "size": [
        ["get", "width"],
        ["get", "height"]
      ],
      "children": [
        {
          "id": "shadow",
          "kind": "rect",
          "color": [0, 0, 0, 0.35]
        },
        {
          "id": "top",
          "use": "frameBeam",
          "x": 2,
          "y": 2,
          "scale": [
            1,
            [
              "/",
              [
                "-",
                ["get", "width"],
                4
              ],
              16
            ]
          ],
          "rotation": -90
        },
        {
          "id": "right",
          "use": "frameBeam",
          "x": [
            "-",
            ["get", "width"],
            2
          ],
          "y": 2,
          "scale": [
            1,
            [
              "/",
              [
                "-",
                ["get", "height"],
                4
              ],
              16
            ]
          ],
          "rotation": 0
        },
        {
          "id": "bottom",
          "use": "frameBeam",
          "x": 2,
          "y": [
            "-",
            ["get", "height"],
            2
          ],
          "scale": [
            1,
            [
              "/",
              [
                "-",
                ["get", "width"],
                4
              ],
              16
            ]
          ],
          "rotation": -90
        },
        {
          "id": "left",
          "use": "frameBeam",
          "x": 2,
          "y": 2,
          "scale": [
            1,
            [
              "/",
              [
                "-",
                ["get", "height"],
                4
              ],
              16
            ]
          ],
          "rotation": 0,
          "lineWidth": 2.4,
          "color": [0.37, 0.88, 1, 0.76]
        }
      ]
    },
    "statBox": {
      "kind": "group",
      "inputs": {
        "label": "Score:",
        "value": ["read", "score"],
        "width": 304,
        "stacked": false,
        "labelFont": "vectrex-menu",
        "valueFont": "neon-hud"
      },
      "size": [
        ["get", "width"],
        ["get", "height"]
      ],
      "clip": true,
      "children": [
        {
          "id": "height",
          "kind": "logic",
          "value": [
            "if",
            ["get", "stacked"],
            88,
            54
          ]
        },
        {
          "id": "frame",
          "use": "bezelFrame",
          "inputs": {
            "width": ["get", "width"],
            "height": ["get", "height"]
          }
        },
        {
          "id": "label",
          "kind": "text",
          "font": ["get", "labelFont"],
          "x": 17,
          "y": [
            "if",
            ["get", "stacked"],
            15,
            19
          ],
          "fontSize": 16,
          "lineWidth": 1.6,
          "color": [1, 0.88, 0.24, 1],
          "text": "{label}"
        },
        {
          "id": "value",
          "kind": "text",
          "x": 17,
          "y": [
            "if",
            ["get", "stacked"],
            41,
            16
          ],
          "size": [
            [
              "-",
              ["get", "width"],
              31
            ],
            32
          ],
          "align": "right",
          "fontSize": [
            "if",
            ["get", "stacked"],
            29,
            22
          ],
          "lineWidth": 2,
          "color": [0.94, 0.98, 1, 1],
          "text": "{value}",
          "font": ["get", "valueFont"]
        }
      ]
    },
    "panel": {
      "kind": "group",
      "inputs": {
        "height": 200,
        "title": "",
        "titleFont": "vectrex-menu"
      },
      "size": [
        304,
        ["get", "height"]
      ],
      "children": [
        {
          "id": "frame",
          "use": "bezelFrame",
          "inputs": {
            "height": ["get", "height"]
          }
        },
        {
          "id": "title",
          "kind": "text",
          "font": ["get", "titleFont"],
          "text": "{title}",
          "fontSize": 17,
          "lineWidth": 1.35,
          "color": [1, 0.88, 0.24, 1],
          "x": 15,
          "y": 13
        },
        {
          "id": "divider",
          "use": "frameBeam",
          "x": 15,
          "y": 37,
          "scale": [
            1,
            [
              "/",
              274,
              16
            ]
          ],
          "rotation": -90,
          "lineWidth": 1.35,
          "color": [0.39, 0.57, 0.68, 0.42]
        }
      ]
    },
    "radialFace": {
      "kind": "group",
      "inputs": {
        "remaining": 0,
        "duration": 1,
        "timeText": "",
        "accent": [0.39, 0.86, 0.96, 1],
        "timeFont": "neon-hud"
      },
      "size": [132, 132],
      "children": [
        {
          "id": "fraction",
          "kind": "logic",
          "value": [
            "normalize",
            ["get", "remaining"],
            0,
            ["get", "duration"]
          ]
        },
        {
          "id": "meterColor",
          "kind": "logic",
          "value": ["get", "accent"]
        },
        {
          "id": "ring",
          "kind": "radial",
          "size": [132, 132],
          "segments": 16,
          "fill": ["get", "fraction"],
          "color": ["get", "meterColor"],
          "trackColor": [0.14, 0.21, 0.28, 1]
        },
        {
          "id": "ring-time",
          "kind": "text",
          "x": 20,
          "y": 55,
          "size": [92, 28],
          "align": "center",
          "fontSize": 21,
          "lineWidth": 2,
          "color": [0.94, 0.98, 1, 1],
          "text": "{timeText}",
          "font": ["get", "timeFont"]
        }
      ]
    },
    "cooldownCard": {
      "kind": "group",
      "size": [["get", "width"], ["get", "height"]],
      "inputs": {
        "rowLabel": "",
        "remaining": 0,
        "duration": 1,
        "timeText": "",
        "tint": [0.39, 0.86, 0.96, 1],
        "labelFont": "neon-hud",
        "width": 304,
        "height": 80
      },
      "children": [
        {
          "id": "frame",
          "use": "bezelFrame",
          "inputs": {
            "width": ["get", "width"],
            "height": ["get", "height"]
          }
        },
        {
          "id": "ring",
          "use": "radialFace",
          "x": 17,
          "y": ["+", 5, ["/", ["-", ["get", "height"], 80], 2]],
          "scale": 0.54,
          "inputs": {
            "remaining": ["get", "remaining"],
            "duration": ["get", "duration"],
            "timeText": ["get", "timeText"],
            "accent": ["get", "tint"]
          }
        },
        {
          "id": "name",
          "kind": "text",
          "text": "{rowLabel}",
          "fontSize": 13.5,
          "lineWidth": 1.35,
          "color": [0.97, 0.99, 1, 1],
          "x": 92,
          "y": ["+", 33, ["/", ["-", ["get", "height"], 80], 2]],
          "font": ["get", "labelFont"]
        }
      ]
    }
  },
  "root": {
    "id": "gridrunner-landscape",
    "kind": "group",
    "inputs": {
      "railScale": [
