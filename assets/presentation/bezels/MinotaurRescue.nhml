NHML 1
# Named scene exports isolate game-facing bindings from node addresses.
input "player.orientation" number "radians"
input "player.fireBoost" number "ratio"
input "level" integer "count"
input "minotaurs.rescued" integer "count"
input "center.contacts" integer "count"
input "player1.hits" integer "count"
input "player2.hits" integer "count"

parameter "foreground.rotation" "node.17.f.4" "radians"
parameter "background.dimensionSpeed" "clock.14.3.speed" "multiplier"
parameter "scene.hue" "runtime.hue" "turns"
parameter "background.rotation" "node.14.f.4" "radians"
parameter "secondary.rotation" "node.4.f.4" "radians"

value "foreground.rotation" "player.orientation" 0 6.283185307179586 0 6.283185307179586 wrap 0 6.283185307179586
value "background.dimensionSpeed" "player.fireBoost" 0 1 0.25 1 clamp 0.25 1
advance "level" "scene.hue" 1 0.166666672 0.138888888888889 0 1 linear
turn "minotaurs.rescued" "scene.hue" 1 0.166666672 1 0 1 linear
turn "center.contacts" "background.rotation" 1 0 6.283185307179586 -6.283185307179586 6.283185307179586 smooth
turn "player1.hits" "background.rotation" 1 0 6.283185307179586 -6.283185307179586 6.283185307179586 smooth
turn "player2.hits" "secondary.rotation" 1 0 -6.283185307179586 -6.283185307179586 6.283185307179586 smooth
