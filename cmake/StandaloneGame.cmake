# Each executable links one game family and the original engine dependencies.
set(_games minotron minorescue goatup minos gridrunner gridrunner-classic fiveaday superoxwars deflex goatup2)
set(_entries kMinotronCore kMinoRescueCore kGoatUpCore kMinosCore kGridrunnerCore kGridrunnerClassicCore kFiveADayCore kSuperOxWarsCore kDeflexCore kGoatUp2Core)
set(_targets mino_core_minotron mino_core_minorescue mino_core_goatup mino_core_minos mino_core_gridrunner mino_core_gridrunner mino_core_fiveaday mino_core_superoxwars mino_core_deflex mino_core_goatup2)
if(MINO_STANDALONE_GAME STREQUAL "all")
    if(ANDROID)
        message(FATAL_ERROR "Android standalone APKs select one MINO_STANDALONE_GAME")
    endif()
    set(_selected ${_games})
else()
    if(NOT MINO_STANDALONE_GAME IN_LIST _games)
        message(FATAL_ERROR "Unknown MINO_STANDALONE_GAME '${MINO_STANDALONE_GAME}'. Choose: ${_games}")
    endif()
    set(_selected ${MINO_STANDALONE_GAME})
endif()
add_subdirectory(engine)
set(_modules ${_selected})
list(TRANSFORM _modules REPLACE "^gridrunner-classic$" "gridrunner")
list(REMOVE_DUPLICATES _modules)
foreach(_module IN LISTS _modules)
    add_subdirectory(cores/${_module})
endforeach()
add_library(mino_game_assets STATIC platform/bundled_assets.cpp)
target_include_directories(mino_game_assets PUBLIC platform)
target_link_libraries(mino_game_assets PUBLIC SDL3::SDL3 PRIVATE mino_miniz)
set_target_properties(mino_game_assets PROPERTIES POSITION_INDEPENDENT_CODE ON)
if(NOT ANDROID)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    if(WIN32)
        enable_language(RC)
        set(_format windows)
        set(_extension rc)
    elseif(APPLE)
        set(_format apple)
        set(_extension cpp)
    else()
        set(_format elf)
        set(_extension cpp)
    endif()
endif()
# Apps and their shell checks use the same compile definitions and dependencies.
function(mino_configure_standalone_shell target game entry core)
    target_include_directories(${target} PRIVATE include platform third_party/stb)
    target_compile_definitions(${target} PRIVATE MINO_STANDALONE_GAME="${game}"
        MINO_STANDALONE_CORE=${entry} MINO_NO_PRESENTATION_FILTERS)
    target_link_libraries(${target} PRIVATE ${core} mino_game_assets mino_shared mino_glad SDL3::SDL3)
    mino_copy_standalone_sdl(${target})
endfunction()
function(mino_copy_standalone_sdl target)
    if(WIN32 AND TARGET SDL3::SDL3-shared)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different
                $<TARGET_FILE:SDL3::SDL3-shared> $<TARGET_FILE_DIR:${target}>)
    endif()
endfunction()
foreach(_game IN LISTS _selected)
    list(FIND _games "${_game}" _index)
    list(GET _entries ${_index} _entry)
    list(GET _targets ${_index} _core)
    set(_shell platform/main.cpp platform/display.cpp platform/input.cpp platform/core_registry.cpp)
    if(ANDROID)
        set(_app main)
        add_library(${_app} SHARED ${_shell})
    else()
        set(_app ${_game})
        add_executable(${_app} ${_shell})
        if(WIN32)
            set_target_properties(${_app} PROPERTIES WIN32_EXECUTABLE TRUE)
        endif()
    endif()
    mino_configure_standalone_shell(${_app} "${_game}" ${_entry} ${_core})

    set(_module ${_game})
    if(_game STREQUAL "gridrunner-classic")
        set(_module gridrunner)
    endif()
    if(NOT ANDROID)
        set(_embed "${CMAKE_CURRENT_BINARY_DIR}/${_game}-assets.${_extension}")
        set(_archive "${CMAKE_CURRENT_BINARY_DIR}/${_game}-assets.zip")
        file(GLOB_RECURSE _assets CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/assets/games/${_module}/*")
        add_custom_command(OUTPUT "${_embed}" "${_archive}"
            COMMAND Python3::Interpreter "${PROJECT_SOURCE_DIR}/tools/bundle_game_assets.py"
                --source "${PROJECT_SOURCE_DIR}/assets/games" --archive "${_archive}"
                --embed "${_embed}" --format ${_format} --game ${_module}
            DEPENDS ${_assets} assets/GAME-ASSETS.json tools/bundle_game_assets.py VERBATIM)
        string(REPLACE "-" "_" _key "${_game}")
        set(_asset_target mino_${_key}_standalone_assets)
        add_custom_target(${_asset_target} DEPENDS "${_embed}" "${_archive}")
        add_dependencies(${_app} ${_asset_target})
        target_sources(${_app} PRIVATE "${_embed}")

        if(BUILD_TESTING)
            set(_asset_check mino_${_key}_standalone_asset_checks)
            add_executable(${_asset_check} EXCLUDE_FROM_ALL tests/bundled_assets.cpp "${_embed}")
            target_link_libraries(${_asset_check} PRIVATE mino_game_assets)
            add_dependencies(${_asset_check} ${_asset_target})
            mino_copy_standalone_sdl(${_asset_check})
            add_test(NAME standalone.${_game}.assets COMMAND ${_asset_check}
                "${PROJECT_SOURCE_DIR}/assets/games" ${_module})
            set_tests_properties(standalone.${_game}.assets PROPERTIES LABELS "standalone;assets")
            if(MINO_GRAPHICS_CHECKS)
                set(_resume mino_${_key}_standalone_resume_checks)
                add_executable(${_resume} EXCLUDE_FROM_ALL tests/app_resume.cpp
                    platform/display.cpp platform/input.cpp platform/core_registry.cpp "${_embed}")
                mino_configure_standalone_shell(${_resume} "${_game}" ${_entry} ${_core})
                add_dependencies(${_resume} ${_asset_target})
                add_test(NAME standalone.${_game}.resume COMMAND ${_resume} ${_game}
                    "${PROJECT_BINARY_DIR}/check-output/${_game}-resume" --lose-context)
                set_tests_properties(standalone.${_game}.resume PROPERTIES LABELS "standalone;graphics" TIMEOUT 180)
                if(WIN32)
                    set(_window mino_${_key}_standalone_window_checks)
                    add_executable(${_window} EXCLUDE_FROM_ALL tests/windows_fullscreen.cpp
                        platform/display.cpp platform/input.cpp platform/core_registry.cpp)
                    mino_configure_standalone_shell(${_window} "${_game}" ${_entry} ${_core})
                    add_test(NAME standalone.${_game}.window COMMAND ${_window})
                    set_tests_properties(standalone.${_game}.window PROPERTIES LABELS "standalone;graphics" TIMEOUT 60)
                endif()
            endif()
        endif()
    endif()
endforeach()
if(NOT ANDROID)
    add_custom_target(standalone-games DEPENDS ${_selected})
    if(BUILD_TESTING)
        include(${PROJECT_SOURCE_DIR}/cmake/Checks.cmake)
    endif()
endif()
mino_apply_project_policy("${PROJECT_SOURCE_DIR}")
